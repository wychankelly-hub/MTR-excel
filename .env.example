# ===== 基本 =====
PORT=3000
# 學生及老師瀏覽器使用的網址（OAuth redirect 亦以此為準）
PUBLIC_BASE_URL=http://localhost:3000
# 請設定為長而隨機的字串（例如 openssl rand -hex 32）；不設定則每次重啟都會登出所有人
SESSION_SECRET=
# 以 HTTPS 部署時設為 true
SECURE_COOKIES=false
# 資料儲存位置（包含比賽紀錄及 Google OAuth refresh token，請限制存取權限）
DATA_DIR=./data

# ===== Demo Mode（模擬）=====
# 正式課堂可設為 false，避免任何人以 Demo 身份登入
ALLOW_DEMO_LOGIN=true
DEMO_TEACHER_PIN=2468

# ===== Google Sign-in（登入）=====
GOOGLE_CLIENT_ID=
# 只有以下電郵可成為老師（逗號分隔）
TEACHER_EMAILS=
# （可選）只接受學校網域，例如 school.edu.hk
ALLOWED_EMAIL_DOMAINS=

# ===== Google Sheets / Drive（真實工作表）=====
# 方式 A（建議）：老師以 OAuth 連接，權限只有 drive.file（只可存取本系統建立的檔案）
GOOGLE_CLIENT_SECRET=
# 方式 B：Service Account JSON 金鑰（配合 Shared Drive 資料夾，或老師預先建立並分享的 Sheet）
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# （可選）建立工作表時放入的資料夾 ID（Service Account 必須使用 Shared Drive 資料夾）
GOOGLE_DRIVE_FOLDER_ID=

# ===== 廣東話配音 =====
# false（預設）：未被老師退回的配音都自動播放；true：只播放老師已批准的音檔
AUDIO_REQUIRE_APPROVAL=false
# 產生 TTS 初稿（scripts/generate-tts.js）時使用，伺服器運行時不需要
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=
# 本機粵語 TTS 模型位置（預設 models/vits-cantonese-hf-xiaomaiiwn，由 npm run tts:setup 下載）
TTS_MODEL_DIR=
